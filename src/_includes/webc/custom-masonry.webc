<is-land on:visible>
  <div class="grid" data-rows="masonry" :data-layout="layout" webc:root webc:is="custom-masonry" webc:keep>
    <slot></slot>

    <template data-island="once" webc:raw>
      <script src="/assets/scripts/components/custom-masonry.js" type="module"></script>
    </template>
  </div>
</is-land>
